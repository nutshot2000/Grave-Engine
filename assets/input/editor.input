# Editor play controls (while the scene is playing). NAME = sources.
# Edit and restart the editor; every name is listed at the top of src/input.rs.
# walk drives vehicle motors marked `drive`, or walks the player.
walk   = keys D A, keys ArrowRight ArrowLeft, stick LeftX, pads Right Left
jump   = key W, key ArrowUp, pad A
drop   = key S, key ArrowDown, pad B
crouch = key C, pad X
roll   = key X, pad RB

thrust = key Space, pad RT
pause = key P, pad Start

# Explorer tools while playing; mouse/E drilling is limited to the level canvas.
drill = mouse Primary, key E, pad LT
aim_x = keys L J, stick RightX
aim_y = keys K I, stick RightY

# Material storage and cave workshop controls.
storage = key B, pad LStick
tool_next = key F, pad LB
recipe_next = key ArrowDown, pad Down
recipe_prev = key ArrowUp, pad Up
craft = key Enter, pad Y

# Grapple toggle, then reel in/out; independent from the later jetpack.
grapple = mouse Secondary, key Q, pad RStick
reel = keys Space S, pads Up Down
vent = key V, pad RT
