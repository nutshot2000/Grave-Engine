# Dust Hawk controls. NAME = sources. Edit and restart the game; every name is listed at the top of src/input.rs.
move_x   = keys D A, keys ArrowRight ArrowLeft, stick LeftX, pads Right Left
move_y   = keys S W, keys ArrowDown ArrowUp, stick LeftY, pads Down Up
climb    = keys E Q, pads RB LB
aim_x    = stick RightX
aim_y    = stick RightY
fire     = pad RT
heavy    = key Space, pad LT
winch    = key G, pad A
flares   = key F, pad B
weapon   = pad Y
weapon_1 = key Num1
weapon_2 = key Num2
weapon_3 = key Num3
start    = key Enter, pad Start
pause    = key P, key Escape, pad Start
map      = key M, pad Back
restart  = key R
