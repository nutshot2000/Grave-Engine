transition climb idle priority 97 after 0 when traversal_enabled > 0 & hanging == 0 & climbing == 0 & dead == 0

# Pose blends sampled at the current source stride.
blend idle walk 0.14
blend idle run 0.14
blend idle jump 0.14
blend idle fall 0.14
blend walk idle 0.14
blend walk run 0.14
blend walk jump 0.14
blend walk fall 0.14
