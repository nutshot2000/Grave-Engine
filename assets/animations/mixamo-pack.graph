transition tread jump priority 60 after 0 when airborne > 0 & vy < -0.1 & swimming == 0 & dead == 0
transition tread fall priority 60 after 0 when airborne > 0 & vy >= -0.1 & swimming == 0 & dead == 0
transition jump landing priority 50 after 0 when grounded > 0 & airborne == 0 & swimming == 0 & dead == 0
transition fall landing priority 50 after 0 when grounded > 0 & airborne == 0 & swimming == 0 & dead == 0
transition idle walk priority 0 after 0 when speed > 0.4 & speed < 2.5 & swimming == 0 & airborne == 0 & dead == 0
transition walk idle priority 0 after 0 when speed <= 0.4 & swimming == 0 & airborne == 0 & dead == 0
transition landing walk priority 0 after 0 when speed > 0.4 & speed < 2.5 & swimming == 0 & airborne == 0 & dead == 0 & finished > 0
transition landing idle priority 0 after 0 when speed <= 0.4 & swimming == 0 & airborne == 0 & dead == 0 & finished > 0
transition swim walk priority 0 after 0 when speed > 0.4 & speed < 2.5 & swimming == 0 & airborne == 0 & dead == 0
transition swim idle priority 0 after 0 when speed <= 0.4 & swimming == 0 & airborne == 0 & dead == 0
transition tread walk priority 0 after 0 when speed > 0.4 & speed < 2.5 & swimming == 0 & airborne == 0 & dead == 0
